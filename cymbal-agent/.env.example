# Local development configuration for the Cymbal Operations Coordinator Agent.
# Copy to `.env` and fill in your assigned lab values.
# For deployment, these are set via Terraform / the deploy command.

# --- Vertex AI ---------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Model *serving* endpoint. gemini-3.6-flash is published to `global` only; setting a
# region here causes a 404 on the publisher model. Regional services use REGION below.
GOOGLE_CLOUD_LOCATION=global
PROJECT_ID=your-gcp-project-id
REGION=us-central1

# Alternatively, for Gemini API via Google AI Studio, comment out the block above
# and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Coordinator model.
MODEL=gemini-3.6-flash

# --- BigQuery Conversational Data Agent (Challenge 2.1) ----------------------
# Create the Data Agent in the `global` location: regional endpoints route through
# a different host and cause mTLS / certificate failures from ADK.
DATA_AGENT_ID=cymbal-retail-analytics-data-agent
DATA_AGENT_RESOURCE=projects/your-gcp-project-id/locations/global/dataAgents/cymbal-retail-analytics-data-agent

# --- POS Manual RAG (Challenge 2.2) ------------------------------------------
GOLD_DATASET_ID=cymbal_gold
POS_CHUNK_TABLE_NAME=pos_manual_chunk_embeddings
RAG_SIMILARITY_THRESHOLD=0.70
RAG_TOP_K=3

# --- Cloud Bigtable & MCP Toolbox (Challenge 2.3) ----------------------------
BIGTABLE_INSTANCE_ID=operations-db
BIGTABLE_TABLE_ID=cashier_realtime_alerts
BIGTABLE_ENRICHED_TABLE_ID=pos_transactions_enriched
# Cloud Run URL of your deployed `mcp-toolbox-bigtable` service.
BIGTABLE_MCP_SERVICE_URL=https://mcp-toolbox-bigtable-XXXXXXXX-uc.a.run.app
# Optional: service account to impersonate when minting OIDC tokens. Required on
# Cloudtop / local workstations where ADC is a user credential.
# BIGTABLE_MCP_SERVICE_ACCOUNT=<PROJECT_NUMBER>-compute@developer.gserviceaccount.com

# --- Store entity resolution (Part 5 bonus 3) --------------------------------
# Directory of embedded store names, built by sql/03_store_directory_embeddings.sql.
STORE_DIRECTORY_TABLE_NAME=store_directory_embeddings
# Minimum cosine similarity before a store reference is considered resolved.
STORE_MATCH_THRESHOLD=0.55

# --- End-user credential delegation (Part 5 bonus 1) -------------------------
# Session-state key the hosting application writes the end user's OAuth access token to.
# When present, BigQuery queries execute as that user, so row-level security applies.
END_USER_TOKEN_STATE_KEY=user_access_token
# Set true to refuse the service-identity fallback entirely (fail closed).
REQUIRE_END_USER_AUTH=false

# --- Guardrails --------------------------------------------------------------
# Cap on bytes billed per tool-issued BigQuery query (default 1 GB).
MAX_BYTES_BILLED=1000000000
# Rows the Conversational Data Agent may return. Caps context growth, NOT bytes scanned --
# the Data Agent runs its SQL server-side, so bytes must be capped with a BigQuery custom
# quota instead. See sql/README.md.
DATA_AGENT_MAX_RESULT_ROWS=50
TOOL_MAX_RETRIES=3
TOOL_RETRY_BASE_DELAY=1.0

# --- Agent telemetry (Module 3 / Part 1) ---------------------------------
# BigQueryAgentAnalyticsPlugin streams prompts, responses, tool args, latency,
# token usage and errors to BigQuery over the Storage Write API (gRPC) on a
# background task, so it never blocks agent execution.
# The dataset must already exist in the region named by REGION:
#   bq mk --location=us-central1 -d <PROJECT_ID>:agent_telemetry
BQ_TELEMETRY_DATASET=agent_telemetry
# `events` rather than the plugin default `agent_events`, so the auto-created
# views are v_tool_completed / v_llm_response as the dashboards expect.
BQ_TELEMETRY_TABLE=events
# Set false to run locally without polluting operational dashboards.
BQ_TELEMETRY_ENABLED=true
