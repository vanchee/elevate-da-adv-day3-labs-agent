# Local development configuration for the Cymbal Operations Coordinator Agent.
# Copy to `.env` and fill in your assigned lab values.
# For deployment, these are set via Terraform / the deploy command.

# --- Vertex AI ---------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Model *serving* endpoint. gemini-3.6-flash is published to `global` only; setting a
# region here causes a 404 on the publisher model. Regional services use REGION below.
GOOGLE_CLOUD_LOCATION=global
PROJECT_ID=your-gcp-project-id
REGION=us-central1

# Alternatively, for Gemini API via Google AI Studio, comment out the block above
# and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Coordinator model.
MODEL=gemini-3.6-flash

# --- BigQuery Conversational Data Agent (Challenge 2.1) ----------------------
# Create the Data Agent in the `global` location: regional endpoints route through
# a different host and cause mTLS / certificate failures from ADK.
DATA_AGENT_ID=cymbal-retail-analytics-data-agent
DATA_AGENT_RESOURCE=projects/your-gcp-project-id/locations/global/dataAgents/cymbal-retail-analytics-data-agent

# --- POS Manual RAG (Challenge 2.2) ------------------------------------------
GOLD_DATASET_ID=cymbal_gold
POS_CHUNK_TABLE_NAME=pos_manual_chunk_embeddings
RAG_SIMILARITY_THRESHOLD=0.70
RAG_TOP_K=3

# --- Cloud Bigtable & MCP Toolbox (Challenge 2.3) ----------------------------
BIGTABLE_INSTANCE_ID=operations-db
BIGTABLE_TABLE_ID=cashier_realtime_alerts
BIGTABLE_ENRICHED_TABLE_ID=pos_transactions_enriched
# Cloud Run URL of your deployed `mcp-toolbox-bigtable` service.
BIGTABLE_MCP_SERVICE_URL=https://mcp-toolbox-bigtable-XXXXXXXX-uc.a.run.app
# Optional: service account to impersonate when minting OIDC tokens. Required on
# Cloudtop / local workstations where ADC is a user credential.
# BIGTABLE_MCP_SERVICE_ACCOUNT=<PROJECT_NUMBER>-compute@developer.gserviceaccount.com

# --- Guardrails --------------------------------------------------------------
# Cap on bytes billed per tool-issued BigQuery query (default 1 GB).
MAX_BYTES_BILLED=1000000000
TOOL_MAX_RETRIES=3
TOOL_RETRY_BASE_DELAY=1.0
